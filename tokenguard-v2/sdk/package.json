{
  "name": "tokenguard-sdk",
  "version": "2.0.0",
  "description": "TokenGuard Runtime Protection SDK — anti-clone / DRM-lite for frontend applications",
  "main": "dist/tokenguard.cjs.js",
  "module": "dist/tokenguard.esm.js",
  "browser": "dist/tokenguard.umd.js",
  "exports": {
    ".": {
      "import": "./dist/tokenguard.esm.js",
      "require": "./dist/tokenguard.cjs.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch"
  },
  "keywords": ["drm", "frontend-protection", "anti-clone", "runtime-protection", "tokenguard"],
  "license": "MIT"
}
